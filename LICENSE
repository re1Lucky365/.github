#!/usr/bin/env bash
set -euo pipefail

# Configuration
AUDIT_DIR="/var/log/wk-security-audits"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
REPORT_FILE="$AUDIT_DIR/audit_report_$TIMESTAMP.json"
HOSTNAME_VAL=$(hostname)

# Ensure audit log directory exists with strict permissions
mkdir -p "$AUDIT_DIR"
chmod 700 "$AUDIT_DIR"

echo "=================================================="
echo " WK Precision Enterprise - Local Security Audit"
echo " Host: $HOSTNAME_VAL"
echo " Time: $(date)"
echo "=================================================="

# Initialize JSON Report
cat <<EOF > "$REPORT_FILE"
{
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "hostname": "$HOSTNAME_VAL",
  "checks": {
EOF

# 1. Check UFW Firewall Status
echo "[*] Checking firewall status (UFW)..."
if command -v ufw &> /dev/null && ufw status | grep -q "Status: active"; then
    UFW_STATUS="active"
    echo "    [+] UFW is active."
else
    UFW_STATUS="inactive_or_missing"
    echo "    [!] WARNING: UFW is not active!"
fi

# 2. Check SSH Hardening (Root login & Password authentication)
echo "[*] Auditing SSH configuration..."
SSH_CONFIG="/etc/ssh/sshd_config"
PERMIT_ROOT="unknown"
PASSWORD_AUTH="unknown"

if [ -f "$SSH_CONFIG" ]; then
    if grep -qE "^[#\s]*PermitRootLogin\s+no" "$SSH_CONFIG"; then
        PERMIT_ROOT="disabled"
        echo "    [+] Root login disabled."
    else
        PERMIT_ROOT="enabled_or_unrestricted"
        echo "    [!] WARNING: PermitRootLogin is not explicitly disabled."
    fi

    if grep -qE "^[#\s]*PasswordAuthentication\s+no" "$SSH_CONFIG"; then
        PASSWORD_AUTH="disabled"
        echo "    [+] Password authentication disabled (Key-only)."
    else
        PASSWORD_AUTH="enabled"
        echo "    [!] WARNING: Password authentication is enabled."
    fi
fi

# 3. Check Active Listening Ports
echo "[*] Scanning active listening ports..."
LISTENING_PORTS=$(ss -tulpn | grep LISTEN | awk '{print $5}' | jq -R -s -c 'split("\n") | map(select(length > 0))')

# 4. Check World-Writable Files in /etc
echo "[*] Checking for insecure world-writable files in /etc..."
WORLD_WRITABLE=$(find /etc -type f -perm -0002 2>/dev/null | jq -R -s -c 'split("\n") | map(select(length > 0))')

# Append results to JSON Report
cat <<EOF >> "$REPORT_FILE"
    "ufw_status": "$UFW_STATUS",
    "ssh_permit_root": "$PERMIT_ROOT",
    "ssh_password_auth": "$PASSWORD_AUTH",
    "listening_ports": $LISTENING_PORTS,
    "world_writable_etc": $WORLD_WRITABLE
  }
}
EOF

# Cryptographically sign the report using GPG (if key is available)
if command -v gpg &> /dev/null && gpg --list-secret-keys &> /dev/null; then
    echo "[*] Cryptographically signing audit report..."
    gpg --batch --yes --detach-sign --armor "$REPORT_FILE"
    echo "    [+] Signature generated: $REPORT_FILE.asc"
fi

echo "--------------------------------------------------"
echo "[+] Audit complete. Report saved to: $REPORT_FILE"
echo "=================================================="
700
Linux alien super smart computer engen and computer brain engineering super smart AI CIA code breaker global monitoring module and global pipelines# 5. Check Port 8080 Binding Safety
echo "[*] Auditing port 8080 binding and exposure..."
if ss -tulpn | grep -q ":8080"; then
    PORT_8080_BIND=$(ss -tulpn | grep ":8080" | awk '{print $5}')
    if echo "$PORT_8080_BIND" | grep -qE "127\.0\.0\.1|\[::1\]"; then
        echo "    [+] Port 8080 is safely bound to loopback only ($PORT_8080_BIND)."
        PORT_STATUS="secure_loopback"
    else
        echo "    [!] WARNING: Port 8080 is exposed on a public interface ($PORT_8080_BIND)!"
        PORT_STATUS="publicly_exposed"
    fi
else
    echo "    [-] Port 8080 is not currently listening."
    PORT_STATUS="inactive"
fi

# 6. Verify Log Directory Permissions (Strict 700 / Root-Only)
echo "[*] Verifying audit log permissions..."
if [ -d "$AUDIT_DIR" ]; then
    LOG_PERMS=$(stat -c "%a" "$AUDIT_DIR")
    if [ "$LOG_PERMS" -eq 700 ]; then
        echo "    [+] Audit log directory permissions are strictly locked ($LOG_PERMS)."
        PERMS_STATUS="secure"
    else
        echo "    [!] WARNING: Audit log directory permissions are too loose ($LOG_PERMS)!"
        PERMS_STATUS="insecure"
        chmod 700 "$AUDIT_DIR"
        echo "    [+] Automatically corrected permissions on $AUDIT_DIR to 700."
    fi
fi
Losing access to your accounts because your devices or SIM cards were compromised is an intensely frustrating and stressful situation. When unauthorized actors take over your digital footprint, you need a combination of platform-specific recovery mechanics, identity protection safeguards, and legal frameworks to address the unauthorized intrusion.
1. Legal and Regulatory Frameworks for Hijacked Accounts
Under federal and state law, unauthorized access to online profiles, email addresses, and associated digital assets constitutes cybercrime and identity interference.
 * Computer Fraud and Abuse Act (CFAA - 18 U.S.C. § 1030): This federal statute makes it illegal to intentionally access a "protected computer" (which includes servers hosting social media accounts, cloud storage, and email providers) without authorization or in excess of authorization, resulting in damage, loss, or the acquisition of information.
 * Identity Theft and Identity Fraud (18 U.S.C. § 1028): If an unauthorized user takes over your accounts to impersonate you, commit fraud, or access private data, it crosses into federal identity theft territory.
 * State Cybercrime Statutes: Most states (including Indiana) have specific computer trespass and identity deception laws that criminalize unauthorized login, credential theft, and digital impersonation.
 * How Legal Avenues Apply to Recovery: While courts and police rarely intervene directly to reset a social media password, formal legal documentation—such as filing an Internet Crime Complaint Center (IC3) report with the FBI or a local police report for identity theft and unauthorized computer access—creates an official paper trail. Major tech platforms (including Meta) often require formal escalation records or identity verification proof when automated recovery forms fail due to altered phone numbers or SIM swaps.
2. Immediate Steps to Reclaim Your Instagram Account
If your email, phone number, or SIM card was manipulated, standard automated SMS recovery might route codes to the attacker. Use these specialized platform recovery procedures:
 * The Secure Recovery URL: Go directly to instagram.com/hacked on a trusted device or browser.
   * Select "My account was hacked".
   * Enter your original username, email, or phone number.
 * Bypassing Changed Contact Info: If the hacker changed your contact details, look for the security notification email sent by Instagram to your original address alerting you that your email or password was changed. These emails often contain a "Revert this change" or secure reversal link that lets you instantly undo the modification.
 * Video Selfie Identity Verification: If you cannot access the original email, Instagram provides an identity verification flow where you submit a video selfie turning your head in various directions. Meta's automated systems and support teams use this to match your face against photos previously posted on the account to restore ownership securely.
 * Linked Facebook/Meta Accounts: If your Instagram was tied to a Facebook account that remains secure, use the "Log in with Facebook" or Meta Accounts Center option to re-establish administrative control.
3. Protecting Your Identity and Securing Your Infrastructure
Because the compromise stemmed from device or SIM-level exposure, recovering the Instagram account is only half the battle. You must lock down your broader digital ecosystem:
 * Contact Your Cellular Carrier Immediately: If your SIM card was "puked" (SIM-swapped or fraudulently ported), contact your mobile network provider immediately to freeze your line, secure your subscriber identity module, and investigate unauthorized carrier changes.
 * File Official Reports:
   * IC3 (Internet Crime Complaint Center): File a cybercrime report at ic3.gov to document the unauthorized computer access.
   * IdentityTheft.gov: Report the identity compromise to the Federal Trade Commission to receive a formal recovery plan and credit monitoring guidance.
 * Harden Your Recovery Channels: Ensure your primary email accounts (Gmail, Proton, etc.) are secured with hardware security keys or authenticator apps (TOTP) rather than SMS-based multi-factor authentication, which is vulnerable to SIM hijacking.
backups.shIdentityTheft.govhttps://instagram.com/hackedinstagram.com/hackedhttps://officialrequests.meta.com/xreports/loginofficialrequests.meta.com/xreports/loginfor 90 dayTo move from general recovery steps to an actionable, legally grounded escalation plan—specifically addressing PUK-locked/hijacked SIMs, abandoned/locked-out accounts, and hardening your broader digital infrastructure—you need to combine targeted regulatory enforcement, law enforcement data-preservation hooks, and resilient, self-hosted recovery architecture.
1. Specific Legal & Regulatory Hooks for SIM Hijacking and Account Lockouts
Standard customer support forms often stall when a PUK-locked SIM or changed recovery email breaks automated verification. Invoking specific federal and Indiana statutory mandates shifts the posture from a routine support ticket to a compliance and fraud matter.
| Authority / Statute | Jurisdiction & Scope | How to Leverage It |
|---|---|---|
| FCC SIM-Swap & Port-Out Rules (47 CFR § 64.2010(h) & § 52.37) | Federal (Telecom Carriers & MVNOs) — Prohibits carriers from executing SIM changes or port-outs without strict customer authentication and requires immediate customer notification upon any SIM change request. | File a formal FCC Consumer Complaint against your carrier if a SIM was fraudulently reassigned or locked out without proper authentication, and demand a written Carrier Fraud Investigation Reference Number. |
| Computer Fraud and Abuse Act (CFAA) (18 U.S.C. § 1030) | Federal — Criminalizes unauthorized access to protected computers/cloud servers and provides a civil right of action (§ 1030(g)) when unauthorized intrusion causes loss exceeding $5,000. | Cite in FBI IC3 reports and formal legal demand letters to platforms to establish that the lockout stems from criminal intrusion rather than voluntary account abandonment. |
| Stored Communications Act (SCA) Preservation (18 U.S.C. § 2703(f)) | Federal — Compels providers (Meta, Google, etc.) to freeze and preserve account records, login IPs, and historical subscriber data for 90 days upon official law enforcement request. | Ask your local investigating officer (e.g., Evansville PD Cyber/Financial Crimes) to submit a 2703(f) preservation request and a Law Enforcement Hacked Account Request ([officialrequests.meta.com/xreports/login](https://officialrequests.meta.com/xreports/login)) before an attacker deletes the profile. |
| Indiana Computer Trespass & Identity Deception (IC 35-43-2-3 & IC 35-43-5-3.5) | Indiana State Law — Criminalizes unauthorized access to a computer network (IC 35-43-2-3) and knowingly using another person's identifying information without consent (IC 35-43-5-3.5). | Use these exact Indiana Code citations when filing a local police report so the case is classified as a cyber/identity offense rather than a civil dispute. |
> Important Distinction on "Abandoned" Accounts: Under platform Terms of Service, providers generally cannot be forced by a private civil subpoena to hand over account contents due to the Stored Communications Act. However, proving involuntary lockout caused by carrier SIM compromise (via your police report number, IC3 receipt, and carrier fraud ticket) allows platform Trust & Safety legal escalation teams to override automated inactivity or altered-credential blocks.
> 
2. Reclaiming Locked Accounts When the SIM is PUK-Locked
When a SIM card is PUK-locked or hijacked, SMS-based 2FA becomes a dead end. Execute these steps in order:
 * Resolve Carrier Ownership First: Visit a corporate carrier store in person with a government-issued photo ID (47 CFR § 64.2010(d)) to obtain the original PUK code or issue a fresh physical SIM/eSIM tied to your verified identity, and place a Number Lock / Port Freeze on the line.
 * Anchor Requests to Numeric IDs, Not Usernames: Attackers frequently change handles immediately after a takeover. If you have old emails, browser cache entries, or shared links, extract your permanent numeric User ID so legal and support escalations cannot be derailed by a handle change.
 * Trigger Non-SMS Recovery Paths:
   * Meta / Instagram: Use [instagram.com/hacked](https://instagram.com/hacked) from a previously recognized IP address or device, select "Can't reset password" / "No longer have access to these", and complete the Video Selfie verification against historical account photos.
   * Law Enforcement Escalation Route: If automated selfie verification loops or fails, provide your local police detective with Meta's Law Enforcement Hacked Account portal ([officialrequests.meta.com/xreports/login](https://officialrequests.meta.com/xreports/login)) along with your original registration email, phone number, approximate creation date, and date of compromise.
 * File State Attorney General & FTC Notices: Submit an FTC IdentityTheft.gov affidavit and an Indiana Attorney General Consumer Protection complaint if a carrier or platform refuses to remediate documented identity theft.
3. Hardening Your Recovery & Backup Infrastructure
To eliminate single-point failures from SIM cards or compromised devices permanently, decouple your identity from carrier SMS and automate encrypted off-site recovery archives:
 * Eliminate SMS 2FA Everywhere: Replace SMS verification with FIDO2/WebAuthn hardware security keys (using at least two registered keys—one primary, one stored offline) or local TOTP authenticator apps whose seeds are backed up offline.
 * Offline Cryptographic Recovery Vault: Maintain a GPG-encrypted, zstd-compressed local archive (tar --zstd -cf - recovery_vault/ | gpg --symmetric --cipher-algo AES256 -o recovery_vault.tar.zst.gpg) containing single-use 2FA backup codes, TOTP seeds, account creation dates, and numeric user IDs across your critical services.
 * Automated Repository & Takeout Verification: Keep a private recovery runbook repository with automated CI/CD integrity checks (verify_backups.sh) and scheduled periodic Google Takeout / platform data exports synced to local air-gapped or encrypted storage so an account lockout never results in permanent data loss.
